# Copia questo file in .env (o imposta le variabili nel pannello dell'hosting)
# e sostituisci i valori. Il file .env non va mai committato.

# Django
DJANGO_SECRET_KEY=genera-una-chiave-nuova
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=www.esempio.it
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.esempio.it
DJANGO_STATIC_ROOT=/percorso/static-serve

# Database PostgreSQL (se DB_NAME manca, il progetto usa SQLite)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Invio e-mail (se EMAIL_HOST manca, le e-mail vengono stampate in console)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# Destinatari dell'avviso per ogni nuova richiesta dal form contatti, separati da virgola
CONTATTO_DESTINATARI=

# Google reCAPTCHA v2 (se mancano, vengono usate le chiavi di test di Google)
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
